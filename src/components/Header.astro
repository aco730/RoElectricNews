---
import { categoriiVizibile } from "../data/categories";
import siteConfig from "../data/site-config.json";
import { getContact } from "../lib/contact";

interface Props {
  showCategoryNav?: boolean;
}

const { showCategoryNav = true } = Astro.props;
const { header } = siteConfig;
const contact = await getContact();
---
{header.vizibil && (
  <>
    {header.topbarVizibil && (
      <div class="topbar">
        <span>{header.topbarText}</span>
        <div>
          {header.topbarLinkuri.map((l) => (
            <a href={l.href}>{l.text}</a>
          ))}
        </div>
      </div>
    )}

    <header class="main">
      <a href="/" class="logo">
        {header.logoImagine ? (
          <img src={header.logoImagine} alt="Logo" height="30" />
        ) : (
          <svg width="30" height="30" viewBox="0 0 60 60">
            <polygon points="30,4 52,17 52,43 30,56 8,43 8,17" fill="none" stroke="var(--navy)" stroke-width="3"></polygon>
            <circle cx="30" cy="30" r="7" fill="var(--teal)"></circle>
            <line x1="30" y1="4" x2="30" y2="23" stroke="var(--navy)" stroke-width="2.5"></line>
            <line x1="30" y1="37" x2="30" y2="56" stroke="var(--navy)" stroke-width="2.5"></line>
          </svg>
        )}
        <span>{header.logoTextPrincipal}<span class="news">{header.logoTextAccent}</span></span>
      </a>

      {header.cautareVizibila && (
        <form class="search-box" action="/cauta" method="get">
          <input type="text" id="site-search" name="q" placeholder="Caută articole..." autocomplete="off" />
        </form>
      )}

      <div class="header-ctas">
        <a class="telefon-header" href={`tel:${contact.telefon.replace(/\s+/g, '')}`}>
          <span aria-hidden="true">📞</span> {contact.telefon}
        </a>
        {header.paginaDirecta && (
          <a class="cta-link" href={header.paginaDirecta.href}>{header.paginaDirecta.text}</a>
        )}
        {header.meniuServicii && (
          <div class="nav-dropdown">
            <button type="button" class="cta-link nav-link-caret">
              {header.meniuServicii.text} <span class="caret">▾</span>
            </button>
            <div class="nav-dropdown-menu">
              {header.meniuServicii.itemi.map((it) => (
                <a href={it.href}>{it.text}</a>
              ))}
            </div>
          </div>
        )}
        {header.ctaButoane.map((b) => (
          <a class={`cta-btn ${b.primar ? 'cta-btn-primary' : ''}`} href={b.href}>{b.text}</a>
        ))}
      </div>
    </header>

    {showCategoryNav && (
      <nav class="cats">
        {categoriiVizibile.map((cat) => (
          <a href={`/categorie/${cat.slug}`} class="nav-link" style={`--accent:${cat.color}`}>{cat.name}</a>
        ))}
      </nav>
    )}
  </>
)}

<style>
  .telefon-header {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #1A7A45;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 10px;
  }
  .telefon-header:hover { text-decoration: underline; }
  @media (max-width: 760px) { .telefon-header { display: none; } }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--navy);
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    padding: 9px 14px;
    border-radius: 6px;
  }
  .cta-link:hover {
    background: rgba(15, 46, 43, 0.06);
  }
  .nav-dropdown {
    position: relative;
    flex-shrink: 0;
  }
  .nav-link-caret {
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
  }
  .caret {
    font-size: 10px;
    opacity: 0.8;
    transition: transform 0.15s ease;
  }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 190px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    padding: 6px;
    z-index: 30;
  }
  .nav-dropdown-menu a {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .nav-dropdown-menu a:hover {
    background: var(--bg);
    color: var(--teal);
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    display: block;
  }
  .nav-dropdown:hover .caret,
  .nav-dropdown:focus-within .caret {
    transform: rotate(180deg);
  }
</style>
