---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import portofoliuData from "../../data/portofoliu.json";
import Etichete from "../../components/Etichete.astro";
import { getCtaConfig } from "../../lib/ctaConfig";

const cta = (await getCtaConfig()).portofoliu;

const { proiecte } = portofoliuData as {
  proiecte: { id: string; nume: string; album: string; locatie: string; dataDe: string; poze: unknown[]; cover: string | null; etichete?: string[] }[];
};

const totalPoze = proiecte.reduce((sum, p) => sum + p.poze.length, 0);
const sortate = [...proiecte].sort((a, b) => (b.dataDe || "").localeCompare(a.dataDe || ""));
---
<Layout title="Portofoliu — Solar Electric Panel" description="Lucrări reale de montaj fotovoltaic și electric realizate de Solar Electric Panel — poze din șantiere din zona Făgăraș." singleCol>
  <div class="stat-card">
    <div class="stat-icon">📸</div>
    <div>
      <div class="stat-number">{totalPoze}</div>
      <div class="stat-label">poze din {proiecte.length} șantiere — lucrări reale Solar Electric Panel (2022–2026)</div>
    </div>
  </div>

  <h2 class="section-title">Toate șantierele</h2>
  <div class="story-grid">
    {sortate.map((p) => (
      <article class="story-card">
        {p.cover && (
          <div class="media-wrap">
            <img class="story-media" src={p.cover} alt={p.nume} />
            <Etichete slugs={p.etichete} overlay />
          </div>
        )}
        <span class="badge" style={`background:${p.album === "fotovoltaice" ? "#E97B0F" : "#12213A"}`}>
          {p.album === "fotovoltaice" ? "Fotovoltaic" : "Electric"}
        </span>
        <h3><a href={`/portofoliu/${p.id}`}>{p.nume}</a></h3>
        <div class="meta">
          {p.locatie && <span>{p.locatie}</span>}
          <span>{p.poze.length} poze</span>
        </div>
      </article>
    ))}
  </div>

  <div class="lead-cta">
    <div class="lead-cta-text">
      <strong>{cta.titlu}</strong>
      <span>{cta.text}</span>
    </div>
    <a class="cta-btn cta-btn-primary" href={cta.linkButon}>{cta.textButon}</a>
  </div>
</Layout>
