---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Cere ofertă — Solar Electric Panel"
  description="Calculator rapid: răspunde la câteva întrebări simple și primești 3 variante de sistem fotovoltaic (Buget/Standard/Premium)."
  singleCol
>
  <div class="oferta-hero">
    <h1 class="oferta-hero-title">Obține <span>oferta</span> ta</h1>
    <p class="oferta-hero-sub">Răspunde la câteva întrebări simple — vezi imediat 3 variante de sistem, de la Buget la Premium</p>
    <p class="oferta-hero-sub"><a href="/preturi">Vezi lista completă de prețuri orientative →</a></p>
  </div>

  <div class="wizard-card">
    <div class="wizard-step-label" id="wizardStepLabel">Pasul 1 din 4</div>
    <div class="wizard-progress" id="wizardProgress">
      <span class="wp-step active" data-step="1">1</span>
      <span class="wp-line"></span>
      <span class="wp-step" data-step="2">2</span>
      <span class="wp-line"></span>
      <span class="wp-step" data-step="3">3</span>
      <span class="wp-line"></span>
      <span class="wp-step" data-step="4">4</span>
    </div>
    <div class="wizard-recap" id="wizardRecap"></div>

    <!-- Step 1: tip cladire -->
    <div class="wizard-step active" data-step="1">
      <h2>Pentru ce ai nevoie de sistem?</h2>
      <div class="wizard-options">
        <button type="button" class="wizard-option" data-field="tipCladire" data-value="casa">🏠<span>Casă</span></button>
        <button type="button" class="wizard-option" data-field="tipCladire" data-value="firma">🏢<span>Firmă / spațiu comercial</span></button>
      </div>
      <button type="button" class="cta-btn cta-btn-primary wizard-continue" data-step="1" disabled>Continuă</button>
    </div>

    <!-- Step 2: consum -->
    <div class="wizard-step" data-step="2">
      <h2>Cât consumi de obicei?</h2>
      <p class="wizard-hint">Alege ce știi mai bine, apoi completează suma.</p>
      <div class="wizard-options wizard-options-inline" id="consumTipOptions">
        <button type="button" class="wizard-option-toggle" data-field="stieCe" data-value="factura">Știu factura lunară (lei)</button>
        <button type="button" class="wizard-option-toggle" data-field="stieCe" data-value="consum">Știu consumul anual (kWh)</button>
      </div>
      <div class="wizard-input-row" id="inputFactura" hidden>
        <label for="facturaLunara">Factura medie lunară la curent (lei)</label>
        <input type="number" id="facturaLunara" min="0" placeholder="ex: 450" />
      </div>
      <div class="wizard-input-row" id="inputConsum" hidden>
        <label for="consumAnual">Consum anual (kWh)</label>
        <input type="number" id="consumAnual" min="0" placeholder="ex: 4800" />
      </div>
      <button type="button" class="cta-btn cta-btn-primary wizard-continue" data-step="2" disabled>Continuă</button>
    </div>

    <!-- Step 3: baterie -->
    <div class="wizard-step" data-step="3">
      <h2>Vrei și baterie de stocare?</h2>
      <p class="wizard-hint">Bateria îți permite să folosești energia produsă ziua și seara/noaptea, nu doar în timp real.</p>
      <div class="wizard-options">
        <button type="button" class="wizard-option" data-field="baterie" data-value="da">🔋<span>Da, vreau baterie</span></button>
        <button type="button" class="wizard-option" data-field="baterie" data-value="nu">☀️<span>Nu, doar panouri</span></button>
        <button type="button" class="wizard-option" data-field="baterie" data-value="nustiu">🤔<span>Nu știu — recomandați voi</span></button>
      </div>
      <button type="button" class="cta-btn cta-btn-primary wizard-continue" data-step="3" disabled>Continuă</button>
    </div>

    <!-- Step 4: orientare acoperis (multi-select) -->
    <div class="wizard-step" data-step="4">
      <h2>Cum e orientat acoperișul?</h2>
      <p class="wizard-hint">Poți bifa mai multe orientări, dacă acoperișul are mai multe ape. Aproximativ e suficient — verificăm exact la vizita tehnică.</p>
      <div class="wizard-options" id="orientareOptions">
        <button type="button" class="wizard-option wizard-option-multi" data-field="orientare" data-value="Sud">☀️<span>Sud</span></button>
        <button type="button" class="wizard-option wizard-option-multi" data-field="orientare" data-value="Est">🌅<span>Est</span></button>
        <button type="button" class="wizard-option wizard-option-multi" data-field="orientare" data-value="Vest">🌇<span>Vest</span></button>
        <button type="button" class="wizard-option wizard-option-multi" data-field="orientare" data-value="nustiu">🤷<span>Nu știu</span></button>
      </div>
      <button type="button" class="cta-btn cta-btn-primary wizard-continue" data-step="4" disabled>Vezi variantele</button>
    </div>

    <div class="wizard-nav">
      <a href="/" class="btn-back" id="wizardBackUnified">← Renunță, du-mă înapoi pe site</a>
    </div>
  </div>

  <!-- Loading -->
  <div class="wizard-card" id="wizardLoading" hidden>
    <p style="text-align:center;color:var(--muted);">Calculăm cele 3 variante...</p>
  </div>

  <!-- Rezultat: 3 variante -->
  <div id="wizardResults" hidden>
    <h2 class="section-title">Variantele tale</h2>
    <div class="variant-grid" id="variantGrid"></div>
    <p class="note" style="text-align:center;margin-top:10px;">
      Prețuri estimative, incluzând materiale și manoperă montaj — confirmate exact după vizita tehnică gratuită.
    </p>
    <div class="wizard-nav" style="justify-content:center;margin-top:12px;">
      <button type="button" class="btn-back" id="resultsBack">← Modifică răspunsurile</button>
    </div>
  </div>

  <!-- Formular de contact -->
  <div class="wizard-card" id="contactCard" hidden>
    <h2>Aproape gata — unde trimitem oferta?</h2>
    <p class="wizard-hint" id="chosenVariantSummary"></p>
    <div class="quick-actions">
      <button type="button" class="quickbtn" id="reopenOfferBtn">📄 Redeschide oferta</button>
      <a class="quickbtn" href="tel:0750405908">📞 Sună acum</a>
      <a class="quickbtn" href="mailto:solarelectricpanel@gmail.com">✉️ Email</a>
      <a class="quickbtn" href="/servicii">← Înapoi la Servicii</a>
    </div>
    <form
      name="cerere-oferta"
      method="POST"
      data-netlify="true"
      netlify-honeypot="companie-web"
      id="offerForm"
    >
      <input type="hidden" name="form-name" value="cerere-oferta" />
      <input type="hidden" name="varianta" id="fVarianta" />
      <input type="hidden" name="detalii-sistem" id="fDetalii" />
      <p class="honeypot"><label>Nu completa acest câmp: <input name="companie-web" /></label></p>

      <div class="form-field">
        <label for="nume">Nume</label>
        <input type="text" id="nume" name="nume" required />
      </div>
      <div class="form-field">
        <label for="telefon">Telefon</label>
        <input type="text" id="telefon" name="telefon" required />
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" />
      </div>
      <div class="form-field">
        <label for="localitate">Localitate</label>
        <input type="text" id="localitate" name="localitate" placeholder="ex: Făgăraș" />
      </div>
      <div class="form-field">
        <label for="mesaj">Mesaj (opțional)</label>
        <textarea id="mesaj" name="mesaj" rows="3"></textarea>
      </div>
      <div data-netlify-recaptcha="true"></div>
      <button type="submit" class="form-submit">Trimite cererea de ofertă</button>
    </form>
  </div>

  <div class="wizard-card" id="thankYou" hidden>
    <h2>Mulțumim!</h2>
    <p>Am primit cererea ta pentru varianta selectată. Te contactăm în cel mai scurt timp pentru a stabili vizita tehnică.</p>
  </div>
</Layout>

<style is:global>
  /* Hero cu gradient + titlu bicolor, doar pentru modulul de oferta */
  .oferta-hero { background: linear-gradient(135deg, var(--navy), #1c3a6b 55%, var(--teal)); border-radius: 20px; padding: 40px 28px 56px; text-align: center; margin-bottom: -34px; position: relative; }
  .oferta-hero-title { color: #fff; font-size: 30px; font-weight: 800; margin: 0 0 10px; }
  .oferta-hero-title span { color: var(--mint); }
  .oferta-hero-sub { color: #d7e6ff; font-size: 14px; max-width: 480px; margin: 0 auto; line-height: 1.6; }
  .oferta-hero-sub a { color: #fff; text-decoration: underline; font-weight: 600; }
  .oferta-hero-sub a:hover { color: var(--mint); }

  .wizard-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 32px; max-width: 640px; margin: 0 auto 24px; position: relative; z-index: 1; box-shadow: 0 18px 40px -12px rgba(18,33,58,0.35); }

  /* Butoane complet rotunjite (pilula), doar in modulul de oferta */
  .wizard-card .cta-btn, .wizard-continue, .quickbtn, #variantGrid .cta-btn { border-radius: 999px; }
  #contactCard .form-submit { border-radius: 999px; }
  .wizard-step-label { text-align: center; font-size: 12px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: var(--teal); margin-bottom: 8px; }
  .wizard-progress { display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 28px; }
  .wp-step { width: 30px; height: 30px; border-radius: 50%; background: var(--border); color: var(--muted); font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; }
  .wp-step.active { background: var(--teal); color: #fff; }
  .wp-step.done { background: var(--navy); color: #fff; }
  .wp-line { width: 28px; height: 2px; background: var(--border); }
  .wizard-recap { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: -14px 0 22px; min-height: 24px; }
  .recap-chip { background: #E6FBF9; color: var(--navy); border: 1px solid var(--teal); border-radius: 20px; padding: 4px 12px; font-size: 12px; font-weight: 600; animation: chip-in 0.25s ease; }
  @keyframes chip-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .wizard-step { display: none; }
  .wizard-step.active { display: block; }
  .wizard-step h2 { text-align: center; font-size: 20px; margin: 0 0 8px; }
  .wizard-hint { text-align: center; color: var(--muted); font-size: 13.5px; margin: 0 0 20px; }
  .wizard-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .wizard-options-inline { grid-template-columns: 1fr 1fr; }
  .wizard-option { background: var(--bg); border: 2px solid var(--border); border-radius: 10px; padding: 20px 12px; font-size: 14px; font-weight: 600; color: var(--text); cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 28px; }
  .wizard-option span { font-size: 13.5px; font-weight: 600; }
  .wizard-option:hover { border-color: var(--teal); }
  .wizard-option.selected { border-color: var(--teal); background: #E6FBF9; }
  .wizard-option-sm { flex-direction: row; font-size: 13.5px; padding: 14px; }
  .wizard-option-toggle { background: var(--bg); border: 2px solid var(--border); border-radius: 10px; padding: 14px; font-size: 13.5px; font-weight: 600; color: var(--text); cursor: pointer; }
  .wizard-option-toggle:hover { border-color: var(--teal); }
  .wizard-option-toggle.selected { border-color: var(--teal); background: #E6FBF9; color: var(--navy); }
  .wizard-input-row { margin-top: 16px; display: flex; flex-direction: column; gap: 6px; }
  .wizard-input-row[hidden] { display: none; }
  .wizard-input-row label { font-size: 13px; font-weight: 600; color: var(--navy); }
  .wizard-input-row input { padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; }
  .wizard-error { color: #B22222; font-size: 13px; text-align: center; margin: 10px 0 0; }
  .wizard-nav { display: flex; justify-content: center; align-items: center; margin-top: 20px; }
  .btn-back { background: none; border: none; color: var(--muted); font-size: 13.5px; cursor: pointer; text-decoration: none; padding: 0; }
  .btn-back:hover { color: var(--teal); }
  .wizard-continue { width: 100%; margin-top: 20px; }
  .wizard-continue:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; opacity: 1; }
  .wizard-continue:disabled:hover { background: var(--border); }
  .wizard-option-multi.selected::after { content: "✓"; position: absolute; top: 6px; right: 8px; font-size: 12px; color: var(--teal); font-weight: 800; }
  .wizard-option-multi { position: relative; }

  .variant-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; max-width: 960px; margin: 0 auto; }
  .variant-card { background: var(--card); border: 2px solid var(--border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; }
  .variant-head { padding: 16px 18px; color: #fff; font-weight: 800; font-size: 16px; text-align: center; }
  .variant-card.buget .variant-head { background: #2E7D32; }
  .variant-card.standard .variant-head { background: var(--navy); }
  .variant-card.premium .variant-head { background: #B8860B; }
  .variant-body { padding: 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .variant-line { display: flex; justify-content: space-between; font-size: 13.5px; color: var(--muted); }
  .variant-line b { color: var(--text); }
  .variant-line-detail { margin-bottom: -6px; }
  .variant-sub { font-size: 11.5px; color: var(--muted); font-style: italic; margin-bottom: 4px; }
  .variant-price { font-size: 26px; font-weight: 800; color: var(--navy); text-align: center; margin: 8px 0; }
  .variant-pick { margin-top: auto; }

  .quick-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 22px; }
  .quickbtn { background: var(--bg); border: 1px solid var(--border); color: var(--navy); font-size: 12.5px; font-weight: 600; padding: 8px 12px; border-radius: 20px; text-decoration: none; cursor: pointer; }
  .quickbtn:hover { border-color: var(--teal); color: var(--teal); }
  .form-field { margin-bottom: 16px; }
  .form-field label { display: block; font-size: 13px; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
  .form-field input, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; font-family: inherit; }
  .form-submit { background: var(--teal); color: #fff; border: none; padding: 12px 22px; border-radius: 6px; font-weight: 700; font-size: 14px; cursor: pointer; width: 100%; }
  .form-submit:hover { opacity: 0.92; }
  .honeypot { position: absolute; left: -9999px; }
</style>

<script>
  interface Product {
    categorie: string; tip: string; tier: string; produs: string; spec: string; pret: number;
    um: string; furnizor: string; wp: number; kwh: number; kwInv: number; kwDesc: number;
    link: string; img: string; fisaTehnica: string;
  }

  const CATEGORY_ORDER = ["Panou","Invertor","Baterie","Modul control baterie","Structura montaj","Cablu DC + conectori","Tablou DC","Tablou AC","Cablu AC + consumabile","Transport"];
  const TIERS = ["Buget","Standard","Premium"] as const;
  const BASE_YIELD = 1180;
  const MONTH_FRACTIONS = [0.035,0.055,0.085,0.105,0.120,0.125,0.130,0.115,0.090,0.068,0.042,0.030];
  const TILT_BREAKPOINTS: [number, number][] = [[0,0.91],[10,0.95],[20,0.98],[30,0.995],[35,1.0],[40,0.995],[45,0.98],[50,0.96],[60,0.91],[90,0.72]];
  const AZIMUTH_FACTORS: Record<string, number> = { "Sud":1.00, "Sud-Est":0.96, "Sud-Vest":0.96, "Est":0.83, "Vest":0.85 };
  const LEI_PER_KWH = 1.0; // estimare simpla, cf. articolelor: 0.85-1.00 lei/kWh
  const TARIF_PANOU = 600, TARIF_PIF = 500, BAT_AUTONOMY_PCT = 75, DC_AC_RATIO = 1.15, TILT_DEFAULT = 30;

  let DATA: Product[] = [];

  function tiltFactor(angle: number) {
    angle = Math.max(0, Math.min(90, angle || 0));
    for (let i = 0; i < TILT_BREAKPOINTS.length - 1; i++) {
      const [a1, f1] = TILT_BREAKPOINTS[i];
      const [a2, f2] = TILT_BREAKPOINTS[i + 1];
      if (angle >= a1 && angle <= a2) return f1 + ((angle - a1) / (a2 - a1)) * (f2 - f1);
    }
    return 1.0;
  }
  function annualYieldPerKWp(azimuth: string, tilt: number) {
    const tf = tiltFactor(tilt);
    const af = AZIMUTH_FACTORS[azimuth] ?? 1.0;
    return MONTH_FRACTIONS.reduce((sum, f) => sum + BASE_YIELD * f * tf * af, 0);
  }
  function monthlyProduction(kWpTotal: number, orientari: string[]) {
    const perOrientation = orientari.map((o) => {
      const tf = tiltFactor(TILT_DEFAULT);
      const af = AZIMUTH_FACTORS[o] ?? 1.0;
      return MONTH_FRACTIONS.map((f) => (kWpTotal / orientari.length) * BASE_YIELD * f * tf * af);
    });
    return MONTH_FRACTIONS.map((_, i) => perOrientation.reduce((sum, arr) => sum + arr[i], 0));
  }

  function productsFor(cat: string) {
    return DATA.filter((d) => d.categorie === cat).sort((a, b) => a.pret - b.pret);
  }

  function detectBatteryModuleBrand(item: Product | null) {
    if (!item || !item.produs) return null;
    const p = item.produs;
    if (/Huawei/i.test(p)) return (item.kwh && item.kwh <= 7) ? "Huawei-5kW" : "Huawei-10kW";
    if (/Dyness\s*Tower/i.test(p)) return "Dyness Tower";
    if (/Pylontech|Force\s*H2/i.test(p)) return "Pylontech Force H2";
    return null;
  }

  function pickForTier(categorie: string, tier: string, params: any): { item: Product | null } {
    let cands = productsFor(categorie);
    if (cands.length === 0) return { item: null };
    let pool = cands.filter((c) => c.tier === tier);
    if (pool.length === 0) pool = cands;

    if (categorie === "Modul control baterie") {
      const batItem = params.selections?.Baterie ?? null;
      const brand = detectBatteryModuleBrand(batItem);
      let matches = brand ? pool.filter((c) => c.tip === brand) : [];
      if (matches.length === 0 && brand) matches = cands.filter((c) => c.tip === brand);
      if (matches.length === 0) matches = pool;
      matches = [...matches].sort((a, b) => a.pret - b.pret);
      return { item: matches[0] ?? null };
    }
    if (categorie === "Invertor" && params.targetInverterKW > 0) {
      const sorted = [...pool].sort((a, b) => Math.abs(a.kwInv - params.targetInverterKW) - Math.abs(b.kwInv - params.targetInverterKW));
      return { item: sorted[0] ?? null };
    }
    const sorted = [...pool].sort((a, b) => a.pret - b.pret);
    return { item: sorted[0] ?? null };
  }

  function defaultQty(categorie: string, item: Product | null, params: any) {
    if (categorie === "Panou" || categorie === "Structura montaj" || categorie === "Cablu DC + conectori") return params.nrPanouri;
    if (categorie === "Modul control baterie") return detectBatteryModuleBrand(params.selections?.Baterie) ? 1 : 0;
    if (categorie === "Baterie") {
      if (!params.areBaterie || !item) return params.areBaterie ? 1 : 0;
      const qtyByCapacity = item.kwh ? Math.max(1, Math.ceil(params.bateriaDorita / item.kwh)) : 1;
      return qtyByCapacity;
    }
    return 1;
  }

  function computeTier(tier: string, params: any) {
    const selections: Record<string, Product | null> = {};
    const qtys: Record<string, number> = {};
    let materialeTotal = 0;
    let puterekWp = 0;

    CATEGORY_ORDER.forEach((cat) => {
      const pick = pickForTier(cat, tier, { ...params, selections });
      selections[cat] = pick.item;
      const qty = defaultQty(cat, pick.item, { ...params, selections });
      qtys[cat] = qty;
      if (pick.item) materialeTotal += pick.item.pret * qty;
      if (cat === "Panou" && pick.item) puterekWp = (pick.item.wp * params.nrPanouri) / 1000;
    });

    const manoperaTotal = TARIF_PANOU * params.nrPanouri + TARIF_PIF;
    const totalGeneral = materialeTotal + manoperaTotal;
    const bateriaItem = selections["Baterie"];
    const invertorItem = selections["Invertor"];
    const bateriaKwh = params.areBaterie && bateriaItem ? (bateriaItem.kwh * qtys["Baterie"]) : 0;

    const lineItems = CATEGORY_ORDER
      .map((cat) => ({ cat, item: selections[cat], qty: qtys[cat] }))
      .filter((li) => li.item && li.qty > 0) as { cat: string; item: Product; qty: number }[];

    return {
      tier, puterekWp, totalGeneral, bateriaKwh, nrPanouri: params.nrPanouri,
      materialeTotal, manoperaTotal,
      panouProdus: selections["Panou"]?.produs ?? "—",
      invertorProdus: invertorItem?.produs ?? "—",
      invertorKw: invertorItem?.kwInv ?? 0,
      bateriaProdus: bateriaKwh > 0 ? (bateriaItem?.produs ?? "—") : null,
      selections, qtys, lineItems,
    };
  }

  // ==== Wizard: un singur pattern peste tot — alegi, butonul de Continuă se activeaza, apesi explicit ====
  const state: Record<string, string> = {};
  let selectedOrientari: string[] = [];
  let currentStep = 1;
  const TOTAL_STEPS = 4;

  function isStepValid(n: number): boolean {
    if (n === 1) return !!state.tipCladire;
    if (n === 2) {
      if (state.stieCe === "factura") return Number((document.getElementById("facturaLunara") as HTMLInputElement)?.value) > 0;
      if (state.stieCe === "consum") return Number((document.getElementById("consumAnual") as HTMLInputElement)?.value) > 0;
      return false;
    }
    if (n === 3) return !!state.baterie;
    if (n === 4) return selectedOrientari.length > 0;
    return false;
  }

  function updateContinueButton(n: number) {
    const btn = document.querySelector<HTMLButtonElement>(`.wizard-continue[data-step="${n}"]`);
    if (btn) btn.disabled = !isStepValid(n);
  }

  function renderRecapChips(uptoStep: number) {
    const chips: string[] = [];
    if (uptoStep > 1 && state.tipCladire) {
      chips.push(state.tipCladire === "casa" ? "🏠 Casă" : "🏢 Firmă");
    }
    if (uptoStep > 2) {
      if (state.stieCe === "factura") {
        const v = (document.getElementById("facturaLunara") as HTMLInputElement)?.value;
        if (v) chips.push(`💡 Factură ~${v} lei/lună`);
      } else if (state.stieCe === "consum") {
        const v = (document.getElementById("consumAnual") as HTMLInputElement)?.value;
        if (v) chips.push(`⚡ ~${v} kWh/an`);
      }
    }
    if (uptoStep > 3 && state.baterie) {
      chips.push(state.baterie === "da" ? "🔋 Cu baterie" : state.baterie === "nu" ? "☀️ Fără baterie" : "🤔 Baterie: recomandați voi");
    }
    if (uptoStep > 4 && selectedOrientari.length > 0) {
      const label = selectedOrientari.includes("nustiu") ? "nu știu" : selectedOrientari.join(" + ");
      chips.push(`🧭 ${label}`);
    }
    const recap = document.getElementById("wizardRecap")!;
    recap.innerHTML = chips.map((c) => `<span class="recap-chip">${c}</span>`).join("");
  }

  function goToStep(n: number) {
    currentStep = n;
    document.querySelectorAll<HTMLElement>(".wizard-step").forEach((el) => {
      el.classList.toggle("active", Number(el.dataset.step) === n);
    });
    document.querySelectorAll<HTMLElement>(".wp-step").forEach((el) => {
      const s = Number(el.dataset.step);
      el.classList.toggle("active", s === n);
      el.classList.toggle("done", s < n);
    });
    document.getElementById("wizardStepLabel")!.textContent = `Pasul ${n} din ${TOTAL_STEPS}`;

    const backLink = document.getElementById("wizardBackUnified") as HTMLAnchorElement;
    if (n === 1) {
      backLink.textContent = "← Renunță, du-mă înapoi pe site";
      backLink.href = "/";
    } else {
      backLink.textContent = "← Întrebarea anterioară";
      backLink.href = "#";
    }
    updateContinueButton(n);
    renderRecapChips(n);
  }

  document.getElementById("wizardBackUnified")?.addEventListener("click", (e) => {
    if (currentStep > 1) {
      e.preventDefault();
      goToStep(currentStep - 1);
    }
    // pe pasul 1, e un link normal catre "/" — navigheaza firesc
  });

  // ---- Selectie simpla (single-select): tip cladire, baterie ----
  document.querySelectorAll<HTMLButtonElement>(".wizard-option:not(.wizard-option-multi)").forEach((btn) => {
    btn.addEventListener("click", () => {
      const field = btn.dataset.field!;
      const value = btn.dataset.value!;
      state[field] = value;

      const step = btn.closest(".wizard-step") as HTMLElement;
      step.querySelectorAll(".wizard-option").forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      updateContinueButton(currentStep);
    });
  });

  // ---- Step consum: alege tip (lunar/anual) ----
  document.querySelectorAll<HTMLButtonElement>(".wizard-option-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const value = btn.dataset.value!;
      state.stieCe = value;
      document.querySelectorAll(".wizard-option-toggle").forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      document.getElementById("inputFactura")!.hidden = value !== "factura";
      document.getElementById("inputConsum")!.hidden = value !== "consum";
      updateContinueButton(2);
    });
  });
  document.getElementById("facturaLunara")?.addEventListener("input", () => updateContinueButton(2));
  document.getElementById("consumAnual")?.addEventListener("input", () => updateContinueButton(2));

  // ---- Step orientare: selectie multipla (checkbox-style) ----
  document.querySelectorAll<HTMLButtonElement>(".wizard-option-multi").forEach((btn) => {
    btn.addEventListener("click", () => {
      const value = btn.dataset.value!;
      if (value === "nustiu") {
        selectedOrientari = ["nustiu"];
        document.querySelectorAll(".wizard-option-multi").forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        updateContinueButton(4);
        return;
      }
      const nustiuBtn = document.querySelector('.wizard-option-multi[data-value="nustiu"]');
      nustiuBtn?.classList.remove("selected");
      selectedOrientari = selectedOrientari.filter((o) => o !== "nustiu");

      if (selectedOrientari.includes(value)) {
        selectedOrientari = selectedOrientari.filter((o) => o !== value);
        btn.classList.remove("selected");
      } else {
        selectedOrientari.push(value);
        btn.classList.add("selected");
      }
      updateContinueButton(4);
    });
  });

  // ---- Butonul unic de Continuă, pe fiecare pas ----
  document.querySelectorAll<HTMLButtonElement>(".wizard-continue").forEach((btn) => {
    btn.addEventListener("click", () => {
      const step = Number(btn.dataset.step);
      if (!isStepValid(step)) return;

      if (step === 4) {
        state.orientare = selectedOrientari.includes("nustiu") ? "Sud" : selectedOrientari.join(",");
        runWizardCalculation();
        return;
      }
      goToStep(step + 1);
    });
  });

  document.getElementById("resultsBack")?.addEventListener("click", () => {
    document.getElementById("wizardResults")!.hidden = true;
    document.querySelector<HTMLElement>(".wizard-card")!.hidden = false;
    goToStep(4);
  });

  async function runWizardCalculation() {
    document.querySelector<HTMLElement>(".wizard-card")!.hidden = true;
    const loading = document.getElementById("wizardLoading")!;
    loading.hidden = false;

    if (DATA.length === 0) {
      try {
        const res = await fetch("/data/materiale-oferta.xlsx");
        const buf = await res.arrayBuffer();
        // @ts-ignore - XLSX global din CDN
        const wb = XLSX.read(buf, { type: "array" });
        const sheetName = wb.SheetNames.find((n: string) => n.trim().toLowerCase() === "materiale generator") || wb.SheetNames.find((n: string) => n.toLowerCase().includes("materiale"));
        const ws = wb.Sheets[sheetName];
        // @ts-ignore
        const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" });
        const headerIdx = rows.findIndex((r: any[]) => (r[0] + "").trim() === "Categorie");
        const headers = rows[headerIdx].map((h: any) => (h + "").trim());
        const col = (name: string) => headers.indexOf(name);
        const idx = {
          cat: col("Categorie"), tip: col("Tip"), tier: col("Tier"), produs: col("Produs"),
          spec: col("Specificatie"), pret: col("PretUnitar"), um: col("UM"), furnizor: col("Furnizor"),
          wp: col("PutereWp_Panou"), kwh: col("CapacitateKWh_Baterie"),
          kwInv: col("PutereKW_Invertor"), kwDesc: col("PutereDescarcareKW_Baterie"),
          link: col("Link"), img: col("ImagineURL"), fisaTehnica: col("FisaTehnicaURL"),
        };
        DATA = [];
        for (let i = headerIdx + 1; i < rows.length; i++) {
          const r = rows[i];
          if (!r || !r[idx.cat] || (r[idx.cat] + "").trim() === "") continue;
          DATA.push({
            categorie: (r[idx.cat] + "").trim(), tip: (r[idx.tip] + "").trim(), tier: (r[idx.tier] + "").trim(),
            produs: (r[idx.produs] + "").trim(), spec: (r[idx.spec] + "").trim(), pret: parseFloat(r[idx.pret]) || 0,
            um: (r[idx.um] + "").trim(), furnizor: (r[idx.furnizor] + "").trim(),
            wp: parseFloat(r[idx.wp]) || 0, kwh: parseFloat(r[idx.kwh]) || 0,
            kwInv: parseFloat(r[idx.kwInv]) || 0, kwDesc: parseFloat(r[idx.kwDesc]) || 0,
            link: idx.link >= 0 ? (r[idx.link] + "").trim() : "",
            img: idx.img >= 0 ? (r[idx.img] + "").trim() : "",
            fisaTehnica: idx.fisaTehnica >= 0 ? (r[idx.fisaTehnica] + "").trim() : "",
          });
        }
      } catch (err) {
        loading.innerHTML = '<p style="text-align:center;color:#B22222;">Nu am putut încărca lista de prețuri. Reîncarcă pagina sau sună-ne direct.</p>';
        return;
      }
    }

    const refPanel = productsFor("Panou")[0];
    if (!refPanel) {
      loading.innerHTML = '<p style="text-align:center;color:#B22222;">Nu există panouri în lista de prețuri momentan.</p>';
      return;
    }

    let consumAnual = 0;
    if (state.stieCe === "factura") {
      const factura = Number((document.getElementById("facturaLunara") as HTMLInputElement).value) || 0;
      consumAnual = (factura / LEI_PER_KWH) * 12;
    } else {
      consumAnual = Number((document.getElementById("consumAnual") as HTMLInputElement).value) || 0;
    }

    const orientari = (state.orientare || "Sud").split(",").filter(Boolean);
    const yieldPerKWp = orientari.reduce((sum, o) => sum + annualYieldPerKWp(o, TILT_DEFAULT), 0) / orientari.length;
    const targetKWp = yieldPerKWp > 0 ? consumAnual / yieldPerKWp : 0;
    const nrPanouri = refPanel.wp > 0 ? Math.max(1, Math.ceil((targetKWp * 1000) / refPanel.wp)) : 0;
    const actualKWp = (nrPanouri * refPanel.wp) / 1000;
    const targetInverterKW = actualKWp / DC_AC_RATIO;
    const areBaterie = state.baterie !== "nu";
    const bateriaDorita = (consumAnual / 365) * (BAT_AUTONOMY_PCT / 100);

    const params = { nrPanouri, targetInverterKW, areBaterie, bateriaDorita };
    const results = TIERS.map((tier) => computeTier(tier, params));
    lastOrientari = orientari;

    renderResults(results);
    loading.hidden = true;
  }

  function fmtPrice(n: number) {
    return Math.round(n).toLocaleString("ro-RO") + " lei";
  }

