  function fmtEUR(ron: number, cursEur: number) {
    if (!ron || !cursEur) return "";
    const eur = ron / cursEur;
    return "≈ " + eur.toLocaleString("ro-RO", { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + " €";
  }
  function componentBoxHTML(label: string, mediaHTML: string, isPhoto: boolean, desc: string, priceRON: number, tierColor: string, cursEur: number) {
