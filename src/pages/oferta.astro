          `, preț estimat ${fmtPrice(chosen.totalGeneral)}`;
        document.getElementById("chosenVariantSummary")!.textContent =
          `Ai ales varianta ${tier} — ${chosen.nrPanouri} panouri, ${chosen.puterekWp.toFixed(2)} kWp, preț estimat ${fmtPrice(chosen.totalGeneral)}. Am deschis oferta completă într-un tab nou.`;

        setTimeout(() => {
          document.getElementById("contactCard")!.hidden = false;
          document.getElementById("contactCard")!.scrollIntoView({ behavior: "smooth" });
        }, 500);
      });
