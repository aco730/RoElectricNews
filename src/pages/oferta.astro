    const benefitsHTML = benefits.map(([title, desc]) =>
      `<div class="bitem"><div class="bicon" style="background:${meta.color}22;color:${meta.color};">&#10003;</div>`
      + `<div><div class="btitle">${escapeHtml(title)}</div><div class="bdesc">${escapeHtml(desc)}</div></div></div>`
    ).join("");

    return `<!DOCTYPE html>`
    + `<html lang="ro"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">`
    + `<title>Ofertă ${meta.label} — ${COMPANY.short} — ${offerNr}</title>`
    + `<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js" integrity="sha384-DhxhYObIMeMNGyAG7iK11OHzBIKyEIeRL0ad1iFPAOwZB8iirUlTT0O/WJJUk8+o" crossorigin="anonymous" referrerpolicy="no-referrer"><\/script>`
    + `<style>`
    + `*{box-sizing:border-box;}body{font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;background:#EEF1F6;color:#1B2430;}`
    + `.sheet{max-width:900px;margin:0 auto;background:#fff;}`
    + `.hdr{display:flex;justify-content:space-between;align-items:center;padding:22px 30px;background:#fff;border-bottom:4px solid ${meta.color};}`
    + `.hdr img{height:56px;}.hdr .contact{text-align:right;font-size:12.5px;color:#445;line-height:1.6;}.hdr .contact b{color:#1F3864;font-size:15px;}`
    + `.banner{background:#1F3864;color:#fff;padding:12px 30px;font-size:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;}.banner b{color:#fff;}`
    + `.hero{padding:26px 30px;background:linear-gradient(135deg,#F4F6F9,#fff);}`
    + `.badge{display:inline-block;background:${meta.color};color:#fff;font-weight:bold;font-size:20px;padding:10px 22px;border-radius:30px;margin-bottom:14px;}`
    + `.hero p{font-size:14px;line-height:1.7;color:#333;max-width:720px;}`
    + `.stats{display:flex;gap:14px;margin-top:16px;flex-wrap:wrap;}`
    + `.stat{flex:1;min-width:150px;background:#fff;border:1px solid #E1E6ED;border-top:3px solid ${meta.color};border-radius:6px;padding:12px 14px;}`
    + `.stat .v{font-size:19px;font-weight:bold;color:#1F3864;}.stat .l{font-size:11.5px;color:#667085;margin-top:2px;}`
    + `.section{padding:24px 30px;border-top:1px solid #E1E6ED;}`
    + `.section h2{font-size:15px;text-transform:uppercase;letter-spacing:0.5px;color:#1F3864;margin:0 0 16px 0;padding-bottom:8px;border-bottom:2px solid ${meta.color};}`
    + `.cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}`
    + `.pcard{background:#fff;border-radius:14px;box-shadow:0 2px 10px rgba(16,24,40,0.09);border:1px solid #EEF1F6;overflow:hidden;display:flex;flex-direction:column;}`
    + `.pcard-top{padding:16px 16px 0 16px;}.pcard-imgwrap{background:#F2F4F7;border-radius:10px;height:104px;display:flex;align-items:center;justify-content:center;overflow:hidden;}`
    + `.pcard-imgwrap img{max-width:82%;max-height:82%;object-fit:contain;}.pcard-imgwrap svg{width:50px;height:50px;}.pcard-imgwrap .ph{font-size:26px;font-weight:bold;}`
    + `.pcard-body{padding:12px 16px 4px 16px;text-align:center;flex:1;}`
    + `.pcard-title{font-size:14.5px;font-weight:bold;color:#1B2430;margin-bottom:4px;}`
    + `.pcard-desc{font-size:10.5px;color:#8a94a6;line-height:1.4;min-height:26px;}`
    + `.pcard-price{font-size:15px;font-weight:bold;color:#1B2430;margin-top:8px;}`
    + `.pcard-tag{margin:12px 16px 16px 16px;padding:8px;border-radius:8px;text-align:center;color:#fff;font-size:11.5px;font-weight:bold;letter-spacing:0.2px;}`
    + `table.items{width:100%;border-collapse:collapse;font-size:13px;}`
    + `table.items th{background:#1F3864;color:#fff;text-align:left;padding:9px 10px;font-size:11.5px;text-transform:uppercase;}`
    + `table.items td{padding:9px 10px;border-bottom:1px solid #EAEDF2;vertical-align:top;}`
    + `table.items td.num{text-align:right;white-space:nowrap;}table.items .small{font-size:11px;color:#667085;}`
    + `table.items td.doccol{width:92px;text-align:center;color:#c8ceda;}`
    + `.doclinks{display:flex;flex-direction:column;gap:4px;align-items:stretch;}`
    + `.doclink{display:inline-block;text-align:center;font-size:9.5px;font-weight:bold;text-decoration:none;padding:3px 6px;border-radius:9px;border:1px solid;white-space:nowrap;}`
    + `.doclink.dl-link{color:#12805c;border-color:#12805c;background:#eafaf3;}.doclink.dl-fisa{color:#1554b3;border-color:#1554b3;background:#eaf2fd;}`
    + `.totalrow{display:flex;justify-content:space-between;align-items:center;background:${meta.color};color:#fff;padding:14px 18px;border-radius:8px;margin-top:14px;font-size:18px;font-weight:bold;}`
    + `.chartwrap{position:relative;height:280px;}.bgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}`
    + `.bitem{display:flex;gap:10px;align-items:flex-start;}`
    + `.bicon{min-width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:13px;}`
    + `.btitle{font-size:13px;font-weight:bold;color:#1F3864;}.bdesc{font-size:11.5px;color:#556;line-height:1.5;margin-top:2px;}`
    + `.footer{background:#1F3864;color:#dbe4f5;padding:26px 30px;}`
    + `.footer h3{color:#fff;font-size:12.5px;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 6px 0;}`
    + `.footer .fgrid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:18px;}`
    + `.footer p{font-size:12px;line-height:1.6;margin:0;}`
    + `.footer .cta{border-top:1px solid #3a578f;padding-top:16px;text-align:center;font-size:13px;}.footer .cta b{color:#fff;}`
    + `.note{font-size:10.5px;color:#98A2B3;margin-top:10px;}`
    + `.actionbar{position:sticky;top:0;z-index:10;background:#1B2430;padding:10px 16px;display:flex;justify-content:center;gap:10px;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,0.15);}`
    + `.actionbtn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:999px;font-size:13.5px;font-weight:bold;text-decoration:none;border:none;cursor:pointer;}`
    + `.actionbtn.primary{background:${meta.color};color:#fff;}`
    + `.actionbtn.secondary{background:#fff;color:#1B2430;}`
    + `.actionbtn.ghost{background:transparent;color:#cbd5e1;border:1px solid #4a5568;}`
    + `@media print{ body{background:#fff;} .sheet{max-width:none;} .actionbar{display:none !important;} }`
    + `</style></head><body>`
    + `<div class="actionbar">`
    + `<button class="actionbtn primary" onclick="window.print()">🖨️ Printează / Salvează PDF</button>`
    + `<a class="actionbtn secondary" href="tel:${escapeHtml(COMPANY.phone.replace(/\s+/g, ""))}">📞 Sună acum: ${escapeHtml(COMPANY.phone)}</a>`
    + `<a class="actionbtn secondary" href="mailto:${escapeHtml(COMPANY.email)}?subject=${encodeURIComponent("Ofertă " + meta.label + " — " + offerNr)}">✉️ Trimite pe email</a>`
    + `<button class="actionbtn ghost" onclick="window.close()">✕ Închide</button>`
    + `</div>`
    + `<div class="sheet">`
    + `<div class="hdr"><img src="${COMPANY.logo}" alt="${COMPANY.short}">`
    + `<div class="contact"><b>${COMPANY.name}</b><br>${escapeHtml(COMPANY.phone)} · ${escapeHtml(COMPANY.email)}<br>${escapeHtml(COMPANY.address)}</div></div>`
    + `<div class="banner"><span>OFERTĂ SISTEM FOTOVOLTAIC${areBaterie ? " + STOCARE" : ""} — VARIANTA ${meta.label}</span><span>Nr. <b>${offerNr}</b> · ${today}</span></div>`
    + `<div class="hero">`
    + `<div class="badge">${res.puterekWp.toFixed(2)} kWp${areBaterie ? " + " + res.bateriaKwh.toFixed(1) + " kWh" : ""}</div>`
    + `<p>Ofertă personalizată pentru un sistem fotovoltaic${areBaterie ? " cu stocare" : " on-grid"}, varianta <b>${meta.label}</b>, dimensionat de echipa ${COMPANY.short} pe baza consumului și acoperișului declarate. Sistemul propus produce estimativ <b>${Math.round(annualProd).toLocaleString("ro-RO")} kWh/an</b>, reducând substanțial factura de energie electrică.</p>`
    + `<div class="stats">`
    + `<div class="stat"><div class="v">${res.puterekWp.toFixed(2)} kWp</div><div class="l">Putere instalată</div></div>`
    + `<div class="stat"><div class="v">${areBaterie ? res.bateriaKwh.toFixed(1) + " kWh" : "—"}</div><div class="l">Capacitate stocare</div></div>`
    + `<div class="stat"><div class="v">${Math.round(annualProd).toLocaleString("ro-RO")} kWh</div><div class="l">Producție anuală estimată</div></div>`
    + `</div></div>`
    + `<div class="section"><h2>Componente sistem</h2><div class="cgrid">${componentsHTML}</div></div>`
    + `<div class="section"><h2>Ce conține oferta</h2>`
    + `<table class="items"><tr><th>Denumire</th><th>Documente</th><th>Cantitate</th><th>Preț unitar</th><th>Total</th></tr>`
    + lineRows
    + `<tr><td colspan="4">${manLabel}</td><td class="num"><b>${fmtPrice(res.manoperaTotal)}</b></td></tr>`
    + `</table>`
    + `<div class="totalrow"><span>TOTAL GENERAL</span><span>${fmtPrice(res.totalGeneral)}</span></div>`
    + `</div>`
    + `<div class="section"><h2>Estimare producție solară anuală</h2>`
    + `<div class="chartwrap"><canvas id="prodChartOffer"></canvas></div>`
    + `<div class="note">Producție estimată pe baza valorilor climatice medii pentru zona Făgăraș/Brașov și a orientării acoperișului declarate — estimare orientativă, nu export exact PVGIS.</div>`
    + `</div>`
    + `<div class="section"><h2>Beneficiile tale</h2><div class="bgrid">${benefitsHTML}</div></div>`
    + `<div class="footer">`
    + `<div class="fgrid">`
    + `<div><h3>Garanții oferite</h3><p>Panouri: 25 ani produs / 30 ani performanță · Invertor: 5-10 ani (extensibil) · Baterie: 10 ani · Manoperă ${COMPANY.short}: 2 ani</p></div>`
    + `<div><h3>Opțiuni finanțare</h3><p>Plată integrală, în tranșe (avans + rest la punerea în funcțiune), sau prin finanțare bancară/rate — detalii la cerere.</p></div>`
    + `</div>`
    + `<div class="cta">Pentru confirmarea ofertei sau întrebări: <b>${escapeHtml(COMPANY.phone)}</b> · <b>${escapeHtml(COMPANY.email)}</b><br>${escapeHtml(COMPANY.address)}</div>`
    + `<div class="note" style="text-align:center;">Ofertă orientativă, valabilă 30 de zile de la data emiterii. Prețurile finale se confirmă la vizita tehnică.</div>`
    + `</div>`
    + `</div>`
    + `<script>`
    + `new Chart(document.getElementById("prodChartOffer").getContext("2d"), {`
    + `  type: "bar",`
    + `  data: { labels: ${chartLabels}, datasets: [{ label: "Producție (kWh)", data: ${chartData}, backgroundColor: "${meta.color}" }] },`
    + `  options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{ y:{ title:{display:true,text:"kWh/lună"} } } }`
    + `});`
    + `<\/script>`
    + `</body></html>`;
  }

  // ---- Submit formular (Netlify Forms via fetch, ramane pe pagina) ----
  document.getElementById("offerForm")?.addEventListener("submit", function (e) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const body = new URLSearchParams(data as any).toString();
    fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body })
      .then(() => {
        document.getElementById("contactCard")!.hidden = true;
        document.getElementById("wizardResults")!.hidden = true;
        document.getElementById("thankYou")!.hidden = false;
        document.getElementById("thankYou")!.scrollIntoView({ behavior: "smooth" });
      })
      .catch(() => {
        alert("A apărut o eroare la trimitere — sună-ne direct sau încearcă din nou.");
      });
  });
</script>

