    const priceLabel = priceRON ? fmtPrice(priceRON) : "";
    const tagText = priceRON ? fmtEUR(priceRON, cursEur) : "Inclus în ofertă";
    return `<div class="pcard">`
      + `<div class="pcard-top"><div class="pcard-imgwrap">${mediaBlock}</div></div>`
      + `<div class="pcard-body">`
        + `<div class="pcard-title">${escapeHtml(label)}</div>`
