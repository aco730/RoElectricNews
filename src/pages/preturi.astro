---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

interface Pachet {
  titlu: string;
  pret: number;
  itemi: string[];
}

const listăComunăSolar = (nrPanouri: number, modelPanou: string, wp: number, modelInvertor: string, kwInv: number, baterieText: string | null) => {
  const itemi = [
    `${nrPanouri} panouri fotovoltaice ${modelPanou} — ${wp}W (${((nrPanouri * wp) / 1000).toFixed(1)} kWp instalați)`,
    `Invertor ${modelInvertor}, ${kwInv} kW`,
  ];
  if (baterieText) itemi.push(baterieText);
  itemi.push(
    "Structură de montaj (acoperiș înclinat sau plat, în funcție de proiect)",
    "Cablare DC completă + conectori MC4",
    "Tablou DC și Tablou AC, echipate",
    "Transport materiale la șantier",
    "Manoperă montaj, punere în funcțiune și configurare",
    "Verificare finală + instructaj de utilizare"
  );
  return itemi;
};

const solarFaraBaterie: Record<number, Pachet[]> = {
