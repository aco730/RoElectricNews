    { titlu: "Buget", pret: 15300, itemi: listăComunăSolar(12, "Longi LR4-72HPH-450M", 450, "Deye SUN-5K-SG05LP1", 5, null) },
    { titlu: "Standard", pret: 16400, itemi: listăComunăSolar(10, "Canadian Solar CS6.2-54TM", 505, "Solis S6-EH1P5K-L-PLUS", 5, null) },
