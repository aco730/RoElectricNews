    { titlu: "Standard", pret: 27700, itemi: listăComunăSolar(20, "Canadian Solar CS6.2-54TM", 505, "Deye SUN-10K-SG02LP1", 10, null) },
    { titlu: "Premium", pret: 33000, itemi: listăComunăSolar(20, "Jinko Tiger Neo bifacial", 515, "Deye SUN-10K-SG01HP3", 10, null) },
  ],
