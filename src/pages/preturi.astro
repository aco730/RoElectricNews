    { titlu: "Buget", pret: 42400, itemi: listăComunăSolar(45, "Longi LR4-72HPH-450M", 450, "Huawei SUN2000-20KTL-M5", 20, null) },
    { titlu: "Standard", pret: 47200, itemi: listăComunăSolar(40, "Canadian Solar CS6.2-54TM", 505, "Deye SUN-20K-SG05LP3", 20, null) },
    { titlu: "Premium", pret: 55100, itemi: listăComunăSolar(39, "Jinko Tiger Neo bifacial", 515, "Solis S6-EH3P20K-H", 20, null) },
  ],
};

const solarCuBaterie: Record<number, Pachet[]> = {
  5: [
    { titlu: "Buget", pret: 19900, itemi: listăComunăSolar(12, "Longi LR4-72HPH-450M", 450, "Deye SUN-5K-SG05LP1", 5, "Baterie Dyness DL5.0C — 5,1 kWh") },
    { titlu: "Standard", pret: 23200, itemi: listăComunăSolar(10, "Canadian Solar CS6.2-54TM", 505, "Solis S6-EH1P5K-L-PLUS", 5, "Baterie Dyness Tower — 5 kWh") },
    { titlu: "Premium", pret: 32100, itemi: listăComunăSolar(10, "Jinko Tiger Neo bifacial", 515, "Solis S6-EH3P5K2-H", 5, "Baterie GoodWe Lynx D HV — 5 kWh") },
  ],
  10: [
    { titlu: "Buget", pret: 32000, itemi: listăComunăSolar(23, "Longi LR4-72HPH-450M", 450, "Huawei SUN2000-10KTL-M1", 10, "Baterie Dyness — 10 kWh") },
    { titlu: "Standard", pret: 41400, itemi: listăComunăSolar(20, "Canadian Solar CS6.2-54TM", 505, "Deye SUN-10K-SG02LP1", 10, "Baterie Dyness Tower TS10 — 10,6 kWh") },
    { titlu: "Premium", pret: 52900, itemi: listăComunăSolar(20, "Jinko Tiger Neo bifacial", 515, "Deye SUN-10K-SG01HP3", 10, "Baterie GoodWe / Huawei — 10 kWh") },
  ],
  20: [
    { titlu: "Buget", pret: 60800, itemi: listăComunăSolar(45, "Longi LR4-72HPH-450M", 450, "Huawei SUN2000-20KTL-M5", 20, "Baterie Dyness — 20 kWh") },
    { titlu: "Standard", pret: 74600, itemi: listăComunăSolar(40, "Canadian Solar CS6.2-54TM", 505, "Deye SUN-20K-SG05LP3", 20, "Baterie Dyness Tower — 20 kWh") },
    { titlu: "Premium", pret: 94700, itemi: listăComunăSolar(39, "Jinko Tiger Neo bifacial", 515, "Solis S6-EH3P20K-H", 20, "Baterie GoodWe / Huawei — 20 kWh") },
